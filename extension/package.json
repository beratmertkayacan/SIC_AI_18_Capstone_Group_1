{
  "name": "kafiai-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "parity-fixture": "esbuild scripts/make-parity-fixture.ts --bundle --platform=node --format=esm --outfile=dist/parity-fixture.mjs --log-level=warning && node dist/parity-fixture.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
